rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{userId} {
      // Anyone authenticated can read profile photos
      allow read: if request.auth != null;
      // Only the owner can write their own photo (max 5 MB, images only)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /project-images/{imageId} {
      // Anyone authenticated can read project images
      allow read: if request.auth != null;
      // Any authenticated user can upload (max 10 MB, images only)
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
